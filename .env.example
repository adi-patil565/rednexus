# ==========================================
# Raktasetu / RedNexus — environment template
#
# Copy to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ==========================================


# ------------------------------------------
# Backend (Express API)
# ------------------------------------------
PORT=8000
NODE_ENV=development

# Postgres + PostGIS (see infra/docker-compose.yml)
DATABASE_URL=postgresql://postgres:password@localhost:5432/rednexus

# Redis (BullMQ job queues: breach detection, reminders, escalation)
REDIS_URL=redis://localhost:6379


# ------------------------------------------
# Firebase Admin SDK (backend token verification)
#
# L1: PREFER AN ABSOLUTE PATH OUTSIDE THE REPOSITORY.
#
# The file is gitignored and has never been committed, but a key living
# inside the project directory is one `zip -r`, one misconfigured
# backup, or one shared folder away from leaving with everything else.
# Nothing about it needs to be in here.
#
#   Windows:  C:/Users/<you>/.secrets/raktasetu-service-account.json
#   Linux:    /etc/raktasetu/service-account.json
#
# In production, prefer the platform's secret store over a file at all.
# ------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/serviceAccountKey.json

# ------------------------------------------
# The single origin allowed to call this API. REQUIRED in production —
# without it CORS would fall back to allowing every origin, and the
# server refuses to start rather than do that quietly.
# ------------------------------------------
WEB_ORIGIN=https://your-app.vercel.app


# ------------------------------------------
# Firebase Web SDK (browser — identity only, no Firestore)
#
# These are public by design (they ship in the JS bundle).
# They are NOT a substitute for server-side authorization.
# ------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Where the browser reaches the Express API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# ------------------------------------------
# ML service (Python — Prophet/SARIMA + scikit-learn)
#
# The backend must degrade to rule-based logic if this is
# unreachable. See Rules.md section 5.
# ------------------------------------------
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_MS=2000
ML_SERVICE_ENABLED=false

# Reproducible synthetic data generation
SYNTHETIC_DATA_SEED=42


# ------------------------------------------
# Threshold engine tuning (Phase 4)
# ------------------------------------------
ROLLING_AVERAGE_WINDOW_DAYS=28


# ------------------------------------------
# Notification delivery (Phase 5/6 — sequential chain)
# ------------------------------------------
FCM_SERVER_KEY=
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
