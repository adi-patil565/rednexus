// Raktasetu — data model.
//
// Scope: Phase 1 (donor onboarding). Institution, User, Donor and
// DonationRecord only. UsageRecord, BloodGroupThreshold, Request,
// NotificationLog and Camp arrive in later phases — migrations are
// additive, so there is no benefit to guessing them now.
//
// Field selection for Donor comes from the D Y Patil Hospital Blood
// Centre donor questionnaire (DYPHRC/BC/MER/FM/01V_3.0). Only fields
// that change how the SYSTEM behaves are stored. The medical and TTI
// screening sections of that form stay on paper, answered in person at
// the blood centre. See PRD "Non-Goals".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  O_POS
  O_NEG
  AB_POS
  AB_NEG
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DonorStatus {
  PROVISIONAL           // registered, first donation not yet confirmed
  PENDING_REVIEW        // answered YES to "ever advised not to donate?"
  ACTIVE                // in the targeting pool
  PERMANENTLY_DEFERRED  // form page 4 Outcome: "Permanent deferral"
}

enum DonationType {
  VOLUNTARY
  REPLACEMENT
}

enum DeferralType {
  TEMPORARY
  PERMANENT
}

enum UserRole {
  BLOOD_BANK_STAFF
  PLATFORM_ADMIN
}

enum InstitutionCategory {
  IN_HOUSE // embedded in one hospital
  EXTERNAL // standalone, serves multiple hospitals
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

// Blood is not issuable the moment it leaves the donor's arm. It must
// pass mandatory TTI screening (HIV, hepatitis B and C, syphilis,
// malaria - the tests the donor consents to on page 3 of the paper
// form) before it can be released to the shelf.
//
// The app never decides this. RELEASED records that blood bank staff
// released the unit; it is not the app judging a screening result
// (Rules section 1: the app never declares medical fitness).
enum ScreeningStatus {
  PENDING_SCREENING
  RELEASED
  DISCARDED
}

enum NotificationChannel {
  PUSH
  SMS
  IVR
  EMAIL
}

// ============================================================
// User — staff and admin logins. Distinct from Donor.
// ============================================================

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique // the ONLY link to Firebase Auth
  name        String
  email       String   @unique
  phone       String?

  // Server-controlled. Never settable from a client payload — that was
  // the privilege-escalation path in the Firestore implementation.
  role UserRole

  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  verifiedInstitutions Institution[]    @relation("InstitutionVerifier")
  reviewedDonors       Donor[]          @relation("DonorReviewer")
  recordedDonations    DonationRecord[] @relation("DonationRecorder")
  usageReports         UsageRecord[]    @relation("UsageReporter")
  confirmedThresholds  BloodGroupThreshold[] @relation("ThresholdConfirmer")
  screenedDonations    DonationRecord[] @relation("DonationScreener")

  @@index([institutionId])
  @@map("users")
}

// ============================================================
// Institution — always type BLOOD_BANK; category is context.
// ============================================================

model Institution {
  id                 String              @id @default(uuid())
  name               String
  category           InstitutionCategory
  linkedHospitalName String? // IN_HOUSE only; display context, not a login
  pincode            String
  address            String?

  // Server-controlled. A blood bank cannot verify itself, and cannot
  // act on the platform until a PLATFORM_ADMIN sets this to VERIFIED.
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedByUserId   String?
  verifiedBy         User?              @relation("InstitutionVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?

  // TODO(Phase 5): add `location geography(Point,4326)` for PostGIS
  // distance ranking. Deferred so the first migration does not depend
  // on the postgis extension. Pincode is sufficient until then.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff        User[]
  donations    DonationRecord[]
  usageRecords UsageRecord[]
  thresholds   BloodGroupThreshold[]

  @@index([pincode])
  @@index([verificationStatus])
  @@map("institutions")
}

// ============================================================
// Donor
// ============================================================

model Donor {
  id String @id @default(uuid())

  // Null until the donor claims the account. QR camp registration
  // creates the record first; identity can be attached later.
  firebaseUid String? @unique

  // --- Identity (form page 1) ---
  name        String
  gender      Gender // drives the 90d male / 120d female interval
  dateOfBirth DateTime // preferred over the form's free-text "Age"
  phone       String // form: Contact Nos > Mobile. Resi/Office dropped.
  email       String?

  // Rules section 4: store location at the precision matching needs,
  // not the full residential address the paper form collects.
  areaPincode String

  // --- Blood group: two fields, never merged (Rules section 2) ---
  // The donor questionnaire does not ask blood group at all; it appears
  // only on page 4, entered by the medical officer after testing. So a
  // donor's answer at a QR camp is a CLAIM, and the blood centre's is a
  // RESULT. Ranking logic must account for the difference.
  bloodGroupSelfReported BloodGroup
  bloodGroupVerified     BloodGroup?

  // --- Donation history (form Q1) ---
  donatedBefore      Boolean   @default(false)
  priorDonationCount Int? // Q1.1 — seeds the repeat-donor ranking feature
  lastDonationDate   DateTime? // Q1.2 — the eligibility clock

  // --- Donation type (form header: Voluntary / Family-Replacement) ---
  donationType DonationType @default(VOLUNTARY)
  patientName  String? // only when donationType = REPLACEMENT

  // --- Q1.5 "Have you ever been advised not to donate blood?" ---
  // The app never interprets the reason. YES routes to a human,
  // exactly as the paper form routes it to the doctor present.
  advisedNotToDonateFlag Boolean @default(false)

  status DonorStatus @default(PROVISIONAL)

  // --- Deferral (form page 4, "Outcome") ---
  // When set and in the future, overrides the standard interval.
  // The form's free-text "Reasons for Deferral" is deliberately NOT
  // stored: it is sensitive health data with no system behaviour
  // attached to it. It stays on paper.
  deferralUntilDate DateTime?
  deferralType      DeferralType?
  deferralSetByUserId String?
  deferralSetBy       User?    @relation("DonorReviewer", fields: [deferralSetByUserId], references: [id], onDelete: SetNull)
  deferralSetAt       DateTime?

  // --- Consent (form page 3, DPDP Act 2023) ---
  // Non-nullable by design: a donor record cannot exist without it.
  // consentPurpose records what was agreed to, for purpose limitation.
  consentAt      DateTime
  consentPurpose String

  // Consent (e): "I would like to be informed about any abnormal test
  // results done on my donated blood." A donor CHOICE, to be honoured.
  notifyAbnormalResults Boolean @default(false)

  // F3 preference basics. Full profile lands in Phase 6.
  preferredChannel NotificationChannel @default(SMS)

  registeredAtCampId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donations DonationRecord[]

  // NOTE: eligibility is NOT a column. It is computed on read from
  // lastDonationDate, gender and deferralUntilDate (Rules section 2).

  @@index([bloodGroupSelfReported, areaPincode])
  @@index([status])
  @@index([phone])
  @@map("donors")
}

// ============================================================
// DonationRecord — created when a donation actually happens.
// ============================================================

model DonationRecord {
  id      String   @id @default(uuid())
  donorId String
  donor   Donor    @relation(fields: [donorId], references: [id], onDelete: Cascade)
  date    DateTime

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  // Form page 4 "Hb Level". Feeds the F8 Hb trend.
  hbValue Decimal? @db.Decimal(4, 1)

  volumeMl Int?

  // Set by staff at donation time; promotes the donor's verified group.
  bloodGroupVerified BloodGroup?

  recordedByUserId String?
  recordedBy       User?   @relation("DonationRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  // --- Screening and release ---
  //
  // A donation does not become stock on the day it is given. Counting
  // it immediately would tell the threshold engine that supply arrived
  // before it is usable, producing a false "recovered" signal and
  // suppressing an alert that is still needed.
  screeningStatus  ScreeningStatus @default(PENDING_SCREENING)
  releasedAt       DateTime?
  screenedByUserId String?
  screenedBy       User?           @relation("DonationScreener", fields: [screenedByUserId], references: [id], onDelete: SetNull)

  // Whole blood: one donation, one unit.
  unitsContributed Int @default(1)

  // Populated from Phase 5 onward when a donation answers a Request.
  requestId String?

  createdAt DateTime @default(now())

  @@index([donorId, date])
  @@index([institutionId, date])
  @@index([institutionId, screeningStatus, releasedAt])
  @@map("donation_records")
}

// ============================================================
// UsageRecord (T1) — the platform's primary data feed.
//
// One row per institution, per blood group, per day. Reported daily by
// the blood bank, since the blood bank is the party actually issuing
// units and holds the real record.
//
// This is the most critical dependency in the product: the rolling
// average (T2), the threshold, and the recurring collection target (T4)
// are all derived from these rows. PRD section 10 names reporting
// consistency as the top risk, which is why the entry screen has to
// stay under a minute - if it takes longer, staff stop doing it and the
// whole mechanism quietly breaks.
// ============================================================

model UsageRecord {
  id String @id @default(uuid())

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  bloodGroup BloodGroup
  date       DateTime   @db.Date

  // Units dispensed to patients on this date.
  unitsIssued Int

  // Units on the shelf at close of day.
  //
  // Architecture.md section 6 models UsageRecord with unitsIssued only,
  // but T5 breach detection compares CURRENT STOCK against the confirmed
  // threshold - and nothing in the spec held current stock. Capturing it
  // alongside issuance keeps that a single daily form rather than two,
  // which matters given the sub-minute constraint above.
  stockOnHand Int

  // Optional component-level detail, carried over from the shape the
  // existing /api/blood-bank/stock mock already used. Null is fine:
  // whole-blood units are what the threshold engine actually needs.
  prbcUnits      Int?
  ffpUnits       Int?
  plateletUnits  Int?

  reportedByUserId String?
  reportedBy       User?   @relation("UsageReporter", fields: [reportedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per group per day. A correction re-reports the same day,
  // which upserts rather than creating a duplicate - important because
  // the entry screen shows the last 7 days specifically so yesterday's
  // typo is easy to catch and fix.
  @@unique([institutionId, bloodGroup, date])
  @@index([institutionId, date])
  @@map("usage_records")
}

// ============================================================
// BloodGroupThreshold (T2 / T3 / T4) — the core mechanism.
//
// The system PROPOSES a minimum stock threshold and a recurring
// collection target from observed usage. Neither takes effect until a
// named blood bank staff member confirms it.
//
// `confirmedThreshold` being null IS the gate: null means the proposal
// exists but is not active, and nothing in the codebase may read the
// proposal as though it were confirmed. Rules section 1 forbids an
// auto-confirm mode, a bulk-approve shortcut, or any setting that
// disables this - "not configurable" is the phrase used.
// ============================================================

model BloodGroupThreshold {
  id String @id @default(uuid())

  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  bloodGroup    BloodGroup

  // --- T2: system proposal, recomputed as usage accumulates ---
  proposedThreshold       Int
  proposedCollectionTarget Int
  meanDailyUsage          Decimal @db.Decimal(8, 2)
  stdDevDailyUsage        Decimal @db.Decimal(8, 2)

  // Plain-English account of where the numbers came from, shown next to
  // them in the confirmation UI. PRD section 10 names rubber-stamping as
  // a top risk: a number with no visible basis is one staff click
  // through without reading.
  computationBasis String

  // How much data the proposal rests on. Never blocks - PRD section 10
  // says never block on missing data - but the UI must show it.
  daysOfData      Int
  windowDays      Int
  confidence      ThresholdConfidence

  // --- T3: the human gate. Null confirmedThreshold = NOT ACTIVE. ---
  confirmedThreshold        Int?
  confirmedCollectionTarget Int?
  confirmedByUserId         String?
  confirmedBy               User?     @relation("ThresholdConfirmer", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedAt               DateTime?

  // True when staff changed the number before confirming. Worth
  // recording: a proposal that is always edited is a proposal whose
  // formula needs revisiting.
  wasEdited Boolean @default(false)

  proposedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([institutionId, bloodGroup])
  @@index([institutionId])
  @@map("blood_group_thresholds")
}

enum ThresholdConfidence {
  LOW    // sparse data — treat the number as a starting point
  MEDIUM
  HIGH
}
